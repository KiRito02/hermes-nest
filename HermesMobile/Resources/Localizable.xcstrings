{
  "sourceLanguage": "en",
  "strings": {
    "Add image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图片"
          }
        }
      }
    },
    "Attachments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        }
      }
    },
    "Chats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        }
      }
    },
    "Choose model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型"
          }
        }
      }
    },
    "Choose reasoning effort": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择推理强度"
          }
        }
      }
    },
    "Choose the model or reasoning effort, or view exact token usage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型或推理强度，或查看精确令牌用量。"
          }
        }
      }
    },
    "Choose a chat from the sidebar or start a new conversation with your Hermes Agent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏选择聊天，或与 Hermes Agent 开始新对话。"
          }
        }
      }
    },
    "Context window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文窗口"
          }
        }
      }
    },
    "Copy Message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制消息"
          }
        }
      }
    },
    "Copied Message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制消息"
          }
        }
      }
    },
    "Copies this completed message to the clipboard.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这条已完成的消息复制到剪贴板。"
          }
        }
      }
    },
    "Opens the system share sheet for this completed message.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统分享面板来分享这条已完成的消息。"
          }
        }
      }
    },
    "Preparing dropped attachments...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备拖放的附件……"
          }
        }
      }
    },
    "Current model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型"
          }
        }
      }
    },
    "Hermes Runs currently report token usage, but not the exact current prompt size together with this model's context limit. Hermes Nest will not estimate a percentage from cumulative session tokens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes Runs 目前会报告令牌用量，但不会同时提供当前提示的精确大小和该模型的上下文上限。Hermes Nest 不会使用会话累计令牌估算百分比。"
          }
        }
      }
    },
    "Images unavailable with Hermes Runs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes Runs 暂不支持图片"
          }
        }
      }
    },
    "Latest response": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次回复"
          }
        }
      }
    },
    "Message Hermes...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 Hermes 发消息……"
          }
        }
      }
    },
    "Model & Usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型与用量"
          }
        }
