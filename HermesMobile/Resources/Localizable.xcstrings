          "stringUnit": {
            "state": "translated",
            "value": "此配对密钥已被使用。请在 Hermes Agent 服务器上创建新的密钥。"
          }
        }
      }
    },
    "The pairing secret expired. Create a new one on the Hermes Agent host.": {
