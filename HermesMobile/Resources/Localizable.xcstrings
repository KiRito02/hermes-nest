{
  "sourceLanguage": "en",
  "strings": {
    "Add image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图片"
          }
        }
      }
    },
    "Attachments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        }
      }
    },
    "Chats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        }
      }
    },
    "Choose model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型"
          }
        }
      }
    },
    "Choose reasoning effort": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择推理强度"
          }
        }
      }
    },
    "Choose a chat from the sidebar or start a new conversation with your Hermes Agent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏选择聊天，或与 Hermes Agent 开始新对话。"
          }
        }
      }
    },
    "Context window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文窗口"
          }
        }
      }
    },
    "Copy Message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制消息"
          }
        }
      }
    },
    "Current model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型"
          }
        }
      }
    },
    "Hermes Runs currently report token usage, but not the exact current prompt size together with this model's context limit. Hermes Nest will not estimate a percentage from cumulative session tokens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes Runs 目前会报告令牌用量，但不会同时提供当前提示的精确大小和该模型的上下文上限。Hermes Nest 不会使用会话累计令牌估算百分比。"
          }
        }
      }
    },
    "Images unavailable with Hermes Runs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes Runs 暂不支持图片"
          }
        }
      }
    },
    "Latest response": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次回复"
          }
        }
      }
    },
    "Message Hermes...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 Hermes 发消息……"
          }
        }
      }
    },
    "Model & Usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型与用量"
          }
        }
      }
    },
    "Model and token usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型与令牌用量"
          }
        }
      }
    },
    "New chat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建聊天"
          }
        }
      }
    },
    "Search chats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索聊天"
          }
        }
      }
    },
    "Send message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送消息"
          }
        }
      }
    },
    "Session totals": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话累计"
          }
        }
      }
    },
    "Share Message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享消息"
          }
        }
      }
    },
    "Shows exact run and session usage. Context occupancy is shown only when Hermes reports it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示精确的 Run 与会话用量；仅在 Hermes 报告时显示上下文占用。"
          }
        }
      }
    },
    "These are exact token counts reported by the completed Hermes Run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是已完成 Hermes Run 报告的精确令牌数。"
          }
        }
      }
    },
    "Usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量"
          }
        }
      }
    },
    "Unavailable because the current Hermes Runs API does not advertise image input.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Hermes Runs API 未声明支持图片输入，因此不可用。"
          }
        }
      }
    },
    "The Board is refreshing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "看板正在刷新。"
          }
        }
      }
    },
    "The selection is no longer available. Refresh the Board and select the Cards again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所选内容已不可用。请刷新看板并重新选择卡片。"
          }
        }
      }
    },
    "The selected Cards will be moved to the archive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所选卡片将移至归档。"
