            "value": "此配对密钥已过期。请在 Hermes Agent 服务器上创建新的密钥。"
          }
        }
      }
    },
    "Enter the HTTPS URL that Lucky or Tailscale proxies to Hermes Nest Companion, then enter a one-time pairing secret created on your Hermes Agent host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
