# Copy to:
#   $XDG_CONFIG_HOME/hermex-companion/hermex-companion.env
# and restrict it to the service account (mode 0600).
#
# The Gateway stays on loopback. Never expose this key through Lucky,
# Tailscale, the App, a URL, logs, or source control.
HERMEX_COMPANION_GATEWAY_URL=http://127.0.0.1:8642
HERMEX_COMPANION_GATEWAY_KEY=replace-with-the-existing-api-server-key
