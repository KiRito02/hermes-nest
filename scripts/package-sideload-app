#!/usr/bin/env python3
"""Validate and package one unsigned iOS app for AltStore/SideStore signing."""

from __future__ import annotations

import argparse
import os
import plistlib
import shutil
import stat
import tempfile
import zipfile
from pathlib import Path


EXPECTED_BUNDLE_ID = "com.kirito02.hermesnest"
FORBIDDEN_BUNDLE_DIRECTORIES = {"PlugIns", "Watch", "Extensions"}


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create an App-only unsigned Hermes Nest IPA."
    )
    parser.add_argument("--app", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    return parser.parse_args()


def validate_app(app: Path) -> None:
    if not app.is_dir() or app.suffix != ".app":
        raise ValueError("--app must name an existing .app directory")

    info_path = app / "Info.plist"
    with info_path.open("rb") as info_file:
        info = plistlib.load(info_file)
    if info.get("CFBundleIdentifier") != EXPECTED_BUNDLE_ID:
        raise ValueError(
            "app bundle ID must be "
            f"{EXPECTED_BUNDLE_ID}, got {info.get('CFBundleIdentifier')!r}"
        )

    for path in app.rglob("*"):
        relative_parts = path.relative_to(app).parts
        if any(
            part in FORBIDDEN_BUNDLE_DIRECTORIES
            for part in relative_parts
        ):
            raise ValueError(
                f"app contains a removed nested product: {path}"
            )
        if path.suffix == ".appex":
            raise ValueError(
                f"app contains an extension bundle: {path}"
            )


def zip_payload(payload_root: Path, output: Path) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary_output = output.with_name(f".{output.name}.tmp")
    temporary_output.unlink(missing_ok=True)
    try:
        with zipfile.ZipFile(
            temporary_output,
            mode="w",
            compression=zipfile.ZIP_DEFLATED,
            compresslevel=9,
        ) as archive:
            for path in sorted(payload_root.rglob("*")):
                archive_name = path.relative_to(
                    payload_root.parent
                ).as_posix()
                if path.is_dir():
                    archive.writestr(f"{archive_name}/", b"")
                    continue
                archive.write(path, archive_name)
        os.chmod(temporary_output, stat.S_IRUSR | stat.S_IWUSR)
        temporary_output.replace(output)
    finally:
        temporary_output.unlink(missing_ok=True)


def package(app: Path, output: Path) -> None:
    app = app.resolve()
    output = output.resolve()
    validate_app(app)

    with tempfile.TemporaryDirectory(
        prefix="hermes-nest-sideload-"
    ) as temporary_directory:
        payload = Path(temporary_directory) / "Payload"
        payload.mkdir()
        packaged_app = payload / "HermesNest.app"
        shutil.copytree(app, packaged_app, symlinks=True)
        validate_app(packaged_app)
        zip_payload(payload, output)


def main() -> None:
    arguments = parse_arguments()
    try:
        package(arguments.app, arguments.output)
    except (OSError, ValueError, plistlib.InvalidFileException) as error:
        raise SystemExit(f"Sideload packaging failed: {error}") from error
    print(f"Created App-only sideload package: {arguments.output}")


if __name__ == "__main__":
    main()
