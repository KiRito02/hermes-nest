#!/usr/bin/env python3
"""Guard manual signed simulator acceptance and the lean PR gate."""

import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PR_WORKFLOW = (ROOT / ".github/workflows/pr-ci.yml").read_text(
    encoding="utf-8"
)
ACCEPTANCE_WORKFLOW = (
    ROOT / ".github/workflows/ios-simulator-acceptance.yml"
).read_text(encoding="utf-8")
APP = (ROOT / "HermesMobile/HermesMobileApp.swift").read_text(encoding="utf-8")
THEME = (ROOT / "HermesMobile/Config/AppTheme.swift").read_text(
    encoding="utf-8"
)
FIXTURE = (
    ROOT / "HermesMobile/Features/Settings/CoreChatLabView.swift"
).read_text(encoding="utf-8")
PROJECT = (
    ROOT / "HermesMobile.xcodeproj/project.pbxproj"
).read_text(encoding="utf-8")
SESSION_VIEW = (
    ROOT
    / "HermesMobile/Features/SessionList/CompanionSessionListView.swift"
).read_text(encoding="utf-8")
SHELL_COMPONENTS = (
    ROOT
    / "HermesMobile/Features/Shared/CompanionShellComponents.swift"
).read_text(encoding="utf-8")
SESSION_SURFACE = SESSION_VIEW + "\n" + SHELL_COMPONENTS
SESSION_VIEW_MODEL = (
    ROOT
    / "HermesMobile/Features/SessionList/CompanionSessionListViewModel.swift"
).read_text(encoding="utf-8")
RUN_SERVICE = (
    ROOT / "HermesMobile/Networking/ConversationRunService.swift"
).read_text(encoding="utf-8")
MESSAGE_ACTIONS = (
    ROOT
    / "HermesMobile/Features/SessionList/CompanionPresentationSupport.swift"
).read_text(encoding="utf-8")
MARKDOWN_RENDERER = (
    ROOT / "HermesMobile/Features/Chat/MarkdownRenderer.swift"
).read_text(encoding="utf-8")
WORKSPACE_MODELS = (
    ROOT / "HermesMobile/Networking/CompanionWorkspaceModels.swift"
).read_text(encoding="utf-8")
LOCALIZATIONS = json.loads(
    (ROOT / "HermesMobile/Resources/Localizable.xcstrings").read_text(
        encoding="utf-8"
    )
)


def require(source: str, snippet: str, description: str) -> None:
    if snippet not in source:
        raise SystemExit(f"Missing {description}: {snippet}")


for snippet, description in [
    ('contains("--core-chat-lab")', "core chat Debug launch hook"),
    ("CoreChatLabView()", "core chat fixture view"),
    (
        '"--core-chat-ipad-lab"',
        "adaptive iPad Debug launch hook",
    ),
    (
        '"--core-chat-compact-lab"',
        "compact Stage Manager-width Debug launch hook",
    ),
    (
        '"--companion-shell-lab"',
        "production App-shell Debug launch hook",
    ),
]:
    require(APP, snippet, description)

require(
    PROJECT,
    "CoreChatLabView.swift in Sources",
    "core chat fixture target membership",
)
require(
    PROJECT,
    "CompanionAttachmentStagerTests.swift in Sources",
    "attachment stager test target membership",
)
require(
    PROJECT,
    "CompanionShellComponents.swift in Sources",
    "shared App-shell component target membership",
)
require(FIXTURE, "CoreChatLabRunService", "local run service")
require(FIXTURE, "runService: runService", "local run service injection")
require(FIXTURE, "AdaptiveCoreChatLabView", "adaptive iPad chat fixture")
require(FIXTURE, "CompanionShellLabView", "production App-shell fixture")
require(
    FIXTURE,
    "CompanionSessionListView(",
    "real production App shell in the fixture",
)
require(
    FIXTURE,
    "requestGeometryUpdate",
    "public landscape geometry request",
)
for forbidden in ["URLSession", "Keychain", "API_SERVER_KEY", "deviceCredential"]:
    if forbidden in FIXTURE:
        raise SystemExit(
            f"Core chat UI smoke fixture must remain server-free: {forbidden}"
        )

attachment_entry = SESSION_VIEW.split(
    "private var companionComposer: some View", maxsplit=1
)[1].split("TextField(", maxsplit=1)[0]
for snippet, description in [
    ("showsAttachmentUnavailable = true", "visible attachment explanation action"),
    (
        "companion.attachment.unavailable",
        "attachment accessibility identifier",
    ),
    (
        "The connected Companion does not advertise the secure upload contract.",
        "capability-gated attachment availability explanation",
    ),
]:
    require(attachment_entry, snippet, description)
if "Menu {" in attachment_entry or ".disabled(true)" in attachment_entry:
    raise SystemExit(
        "The attachment entry must stay visible; an all-disabled Menu is hidden on iOS."
    )

for snippet, description in [
    ("ChatActionButtonPalette.resolve", "explicit send-button palette"),
    ("CompanionSendButtonStyle()", "custom high-contrast send style"),
    (
        ".scrollDismissesKeyboard(.interactively)",
        "interactive transcript keyboard dismissal",
    ),
    (
        ".defaultScrollAnchor(\n"
        "                ChatScrollPolicy.initialTranscriptAnchor,\n"
        "                for: .initialOffset\n"
        "            )",
        "initial-only transcript bottom anchor",
    ),
    (
        "ChatScrollPolicy.sizeChangeAnchor(\n"
        "                    shouldFollowLatestMessage:\n"
        "                        shouldFollowLatestMessage\n"
        "                        && !viewModel.isRunActive\n"
        "                ),\n"
        "                for: .sizeChanges",
        "conditional Companion transcript size-change anchor",
    ),
    ("ScrollViewReader { proxy in", "Companion transcript scroll proxy"),
    (
        ".id(transcriptBottomAnchorID)",
        "Companion transcript bottom target",
    ),
    (
        ".onChange(of: viewModel.visibleMessages.last?.id)",
        "window-safe new-message Companion transcript follow trigger",
    ),
    (
        ".onChange(of: viewModel.streamingFollowTrigger)",
        "streaming Companion transcript follow trigger",
    ),
    (
        "UIResponder.keyboardWillShowNotification",
        "keyboard Companion transcript follow trigger",
    ),
    (
        "prepareTranscriptForExplicitSend()",
        "explicit-send Companion transcript follow reset",
    ),
    (
        ".task(id: didCompleteInitialAppearance)",
        "navigation-complete Companion transcript startup",
    ),
    (
        "scheduleInitialTranscriptFollow(proxy)",
        "post-navigation Companion transcript bottom correction",
    ),
    (
        "UIResponder.keyboardDidHideNotification",
        "post-send keyboard-dismissal transcript correction",
    ),
    (
        "viewModel.hasLiveTranscriptContent",
        "live-event-aware post-send keyboard target",
    ),
    (
        "private func scheduleLatestMessageFollow(",
        "stable optimistic-message scroll target",
    ),
    (
        "historyViewModelRegistry: historyViewModelRegistry",
        "navigation-stable Companion run observer ownership",
    ),
    (
        "historyViewModelRegistry?.adopt(",
        "rendered Companion view-model registry adoption",
    ),
    (
        "dismissComposerKeyboard()",
        "empty-transcript keyboard dismissal",
    ),
    (
        "compactComposerContextMenu",
        "consolidated model, reasoning, and usage menu",
    ),
    (
        "dynamicTypeSize.isAccessibilitySize",
        "accessibility-size composer fallback",
    ),
    (
        "Text(option.presentationName)",
        "friendly primary model picker label",
    ),
    (
        "viewModel.selectedModelIdentifier",
        "exact model identifier in usage details",
    ),
    (".searchFocused($isSearchFocused)", "hardware-keyboard search focus"),
    (".focusedSceneValue(", "Companion scene keyboard actions"),
    (
        ".keyboardShortcut(.return, modifiers: .command)",
        "hardware-keyboard send shortcut",
    ),
    (
        "restoreComposerFocusIfNeeded",
        "model and usage composer-focus restoration",
    ),
    (
        ".dropDestination(for: URL.self)",
        "authenticated file drag-and-drop entry",
    ),
    (
        "viewModel.prepareDroppedAttachments(",
        "view-model staging before dropped-file destination selection",
    ),
    (
        "showsUploadDestination = true",
        "authorized upload destination for dropped files",
    ),
    (
        "CompanionTokenPresentation.exactCount",
        "exact Companion token presentation",
    ),
    (
        "enum CompanionShellDestination: CaseIterable, Hashable",
        "typed adaptive App-shell destination routing",
    ),
    (
        "@State private var detailNavigationPath:",
        "state-preserving detail navigation path",
    ),
    (
        ".navigationDestination(for: CompanionShellDestination.self)",
        "native App-shell detail navigation",
    ),
    (
        "CompanionShellDestinationRow(",
        "readable sidebar destination rows",
    ),
    (
        "CompanionConnectionRow(",
        "bottom Companion connection row",
    ),
    (
        ".sheet(isPresented: $showsConnectionDetails)",
        "progressively disclosed Companion connection details",
    ),
]:
    require(SESSION_SURFACE, snippet, description)

shell_source = SESSION_VIEW.split(
    "struct CompanionSessionHistoryView: View", maxsplit=1
)[0]
toolbar_source = shell_source.split(".toolbar {", maxsplit=1)[1].split(
    "        } detail:", maxsplit=1
)[0]
for forbidden in [
    "CompanionDiscoveryView(",
    "CompanionWorkspaceView(",
    "CompanionMemoryView(",
]:
    if forbidden in toolbar_source:
        raise SystemExit(
            "Production destinations belong in the sidebar hierarchy, not "
            f"the crowded shell toolbar: {forbidden}"
        )
require(
    SESSION_VIEW_MODEL,
    "final class CompanionSessionHistoryViewModelRegistry",
    "Companion history view-model registry",
)
require(
    RUN_SERVICE,
    "static let defaultEventConnectTimeoutNanoseconds: UInt64 =",
    "event connect timeout longer than the Gateway keepalive interval",
)
require(
    RUN_SERVICE,
    "45_000_000_000",
    "45-second event first-byte timeout",
)
require(
    SESSION_VIEW,
    "if historyViewModelRegistry == nil {\n"
    "                viewModel.suspendRunObservation()",
    "standalone-only run observer teardown",
)
if ".defaultScrollAnchor(.bottom)" in SESSION_VIEW:
    raise SystemExit(
        "The Companion transcript must not reuse its initial bottom anchor "
        "for keyboard-driven container size changes."
    )

composer = SESSION_VIEW.split(
    "private var companionComposer: some View", maxsplit=1
)[1].split("private var attachmentStrip: some View", maxsplit=1)[0]
if ".background(.regularMaterial)" in composer:
    raise SystemExit(
        "The chat composer must float above the transcript instead of "
        "painting a full-width material slab."
    )
if "\n            modelControls\n" in composer:
    raise SystemExit(
        "Model, reasoning, and usage must not remain as a persistent "
        "three-control row above the input."
    )
for snippet, description in [
    ("actor CompanionAttachmentStager", "isolated attachment stager"),
    (".isRegularFileKey", "regular-file drop validation"),
    (".isSymbolicLinkKey", "symbolic-link drop rejection"),
    ("copiedBytes <= maximumBytes", "bounded streaming copy"),
    ("discardImmediately(staged)", "partial-staging cleanup"),
]:
    require(WORKSPACE_MODELS, snippet, description)
require(
    THEME,
    "struct ChatActionButtonPalette",
    "shared light/dark action palette",
)

message_row = SESSION_VIEW.split(
    "struct CompanionMessageRow", maxsplit=1
)[1].split(
    "private struct CompanionUsageView", maxsplit=1
)[0]
require(
    message_row,
    "CompanionMessageQuickActions",
    "direct finalized-message action row",
)
if "ChatMessageActionsButton" in message_row:
    raise SystemExit(
        "Finalized Companion messages must not hide primary actions "
        "behind an ellipsis-only menu."
    )
for snippet, description in [
    (
        "struct CompanionMessageQuickActions",
        "Companion direct message actions",
    ),
    ('didCopy ? "checkmark" : "doc.on.doc"', "direct Copy icon"),
    ('systemImage: "square.and.arrow.up"', "direct Share icon"),
    (".hoverEffect(", "pointer hover feedback"),
    (".chatMinimumHitTarget(", "minimum action hit target"),
    (
        "Copies this completed message to the clipboard.",
        "direct Copy VoiceOver hint",
    ),
    (
        "Opens the system share sheet for this completed message.",
        "direct Share VoiceOver hint",
    ),
]:
    require(MESSAGE_ACTIONS, snippet, description)

for snippet, description in [
    (
        '? "arrow.left.and.right"\n                            : "arrow.turn.down.left"',
        "action-oriented code wrapping symbol",
    ),
    ('systemName: didCopy ? "checkmark" : "doc.on.doc"', "consistent code Copy icon"),
    (".hoverEffect(.highlight)", "code-action pointer feedback"),
    (".help(", "code-action pointer labels"),
]:
    require(MARKDOWN_RENDERER, snippet, description)

localization_languages = {
    language
    for entry in LOCALIZATIONS["strings"].values()
    for language in entry.get("localizations", {})
}
unexpected_languages = localization_languages - {"en", "zh-Hans"}
if unexpected_languages:
    raise SystemExit(
        "Only English and Simplified Chinese are supported; found: "
        + ", ".join(sorted(unexpected_languages))
    )
for key in [
    "Connection",
    "Gateway status",
    "No matching chats",
    "Opens this destination",
    "Shows Companion connection details",
    "Skills and Toolsets",
    "Unavailable with this Gateway or Companion",
]:
    localization = LOCALIZATIONS["strings"].get(key, {}).get(
        "localizations", {}
    ).get("zh-Hans", {})
    value = localization.get("stringUnit", {}).get("value", "")
    if not value.strip():
        raise SystemExit(
            f"Missing Simplified-Chinese App-shell localization: {key}"
        )
require(
    LOCALIZATIONS["strings"]["Copied Message"]["localizations"]["zh-Hans"][
        "stringUnit"
    ]["value"],
    "已复制消息",
    "Simplified-Chinese copied-message label",
)
require(
    LOCALIZATIONS["strings"]["Search Sessions"]["localizations"]["zh-Hans"][
        "stringUnit"
    ]["value"],
    "搜索会话",
    "Simplified-Chinese keyboard search command",
)

for snippet, description in [
    ("iPhone 17 Pro Max", "preferred reference iPhone"),
    ('echo "udid=${udid}"', "stable simulator UDID output"),
    ("Build signed iPhone acceptance app", "manual signed iPhone build"),
    ("DerivedData-iPhone-Acceptance", "isolated signed DerivedData"),
    ("CODE_SIGNING_ALLOWED=YES", "enabled simulator signing"),
    ("codesign --verify --deep --strict", "signature verification"),
    ('simctl install "${SIMULATOR_UDID}" "${APP_PATH}"', "signed app install"),
    ("capture_screenshots:", "optional screenshot input"),
    ("default: false", "non-blocking acceptance defaults"),
    ("if: inputs.capture_screenshots", "optional screenshot steps"),
    ("--core-chat-lab core-chat-en.png", "English core chat capture"),
    ("--core-chat-lab core-chat-zh-Hans.png", "Simplified Chinese capture"),
    (
        "--companion-shell-lab companion-shell-en.png",
        "English production App-shell capture",
    ),
    (
        "--companion-shell-lab companion-shell-zh-Hans.png",
        "Simplified-Chinese production App-shell capture",
    ),
    ("--long-chat-lab long-chat.png", "long chat capture"),
    ("core-chat-dark.png", "dark-mode core chat capture"),
    ("companion-shell-dark.png", "dark-mode production App-shell capture"),
    ("name: iphone-ui-smoke", "uploaded screenshot artifact"),
    ("run_ipad:", "adaptive iPad input"),
    ("Signed 13-inch iPad Pro Launch", "manual iPad acceptance job"),
    ("iPad Pro 13-inch (M5)", "preferred adaptive iPad"),
    ("core-chat-ipad-portrait.png", "iPad portrait fixture capture"),
    ("core-chat-ipad-landscape.png", "iPad landscape fixture capture"),
    (
        "core-chat-ipad-compact.png",
        "compact Stage Manager-width fixture capture",
    ),
    ("for attempt in {1..8}", "bounded iPad screenshot readiness retries"),
    (
        "if (( byte_count >= 180000 )); then",
        "populated iPad screenshot evidence gate",
    ),
    (
        "Timed out waiting for populated ${filename}",
        "explicit blank iPad screenshot failure",
    ),
    ("name: ipad-ui-smoke", "uploaded iPad screenshot artifact"),
]:
    require(ACCEPTANCE_WORKFLOW, snippet, description)

for forbidden in [
    "Build signed iPhone acceptance app",
    "Capture optional iPhone screenshots",
    "Build adaptive iPad layout",
    "DerivedData-iPhone-Acceptance",
]:
    if forbidden in PR_WORKFLOW:
        raise SystemExit(
            f"Required PR CI must not contain manual acceptance work: {forbidden}"
        )
if "pull_request:" in ACCEPTANCE_WORKFLOW:
    raise SystemExit("Signed simulator acceptance must remain manually dispatched.")
if "CODE_SIGNING_ALLOWED=NO" in ACCEPTANCE_WORKFLOW:
    raise SystemExit("Installable acceptance builds must never disable signing.")
if "${{ secrets." in ACCEPTANCE_WORKFLOW:
    raise SystemExit("UI smoke acceptance must remain independent of repository secrets.")

print("Manual signed simulator acceptance and lean PR CI are valid.")
