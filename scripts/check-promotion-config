#!/usr/bin/env python3
"""Validate the committed ProMotion and adaptive-layout configuration."""

from pathlib import Path
import plistlib


ROOT = Path(__file__).resolve().parent.parent


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(message)


with (ROOT / "HermesMobile/Resources/Info.plist").open("rb") as plist_file:
    app_info = plistlib.load(plist_file)

require(
    app_info.get("CADisableMinimumFrameDurationOnPhone") is True,
    "Info.plist must unlock the full iPhone ProMotion frame-rate range.",
)

mcp_config = (ROOT / ".xcodebuildmcp/config.yaml").read_text(encoding="utf-8")
require(
    'simulatorName: "iPhone 17 Pro Max"' in mcp_config,
    "XcodeBuildMCP must use iPhone 17 Pro Max as the reference simulator.",
)

project = (ROOT / "HermesMobile.xcodeproj/project.pbxproj").read_text(
    encoding="utf-8"
)
require(
    'TARGETED_DEVICE_FAMILY = "1,2";' in project,
    "HermesMobile must continue targeting both iPhone and iPad.",
)

companion_view = (
    ROOT / "HermesMobile/Features/SessionList/CompanionSessionListView.swift"
).read_text(encoding="utf-8")
require(
    "isStreaming: viewModel.isRunActive" in companion_view,
    "The Companion response bubble must use the streaming render path.",
)

pr_workflow = (ROOT / ".github/workflows/pr-ci.yml").read_text(
    encoding="utf-8"
)
require(
    'preferred = "iPhone 17 Pro Max"' in pr_workflow,
    "PR CI must prefer the reference iPhone Pro Max simulator.",
)

acceptance_workflow = (
    ROOT / ".github/workflows/ios-simulator-acceptance.yml"
).read_text(encoding="utf-8")
require(
    "Signed 13-inch iPad Pro Launch" in acceptance_workflow
    and "if: inputs.run_ipad" in acceptance_workflow,
    "Manual acceptance must provide an opt-in adaptive iPad Pro launch.",
)

print("ProMotion and adaptive-layout configuration: OK")
